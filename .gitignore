# --- Виртуальные окружения (обязательно игнорировать) ---
.venv/
venv/
env/
.env/

# --- Кэш Python и скомпилированные файлы ---
__pycache__/
*.py[cod]
*$py.class

# --- Кэш линтеров и форматтеров ---
.ruff_cache/
.pytest_cache/

# --- Файлы операционной системы (особенно важно для macOS) ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- Файлы редакторов кода (IDE) ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Артефакты сборки и дистрибуции (на будущее) ---
build/
dist/
*.egg-info/
